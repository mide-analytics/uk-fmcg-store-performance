        ],
        "lineageTag": "6204cfe1-489d-4e97-91ea-d7961cdf70ac",
        "measures": [
          {
            "name": "Net sales",
            "expression": "SUM('Weekly Sales'[Sales Pence]) / 100",
            "formatString": "£#,0;−£#,0",
            "lineageTag": "093b3cef-f07f-4f42-ba4c-e5b132659ac3"
          },
          {
            "name": "Prior-year sales",
            "expression": "SUM('Weekly Sales'[Prior Sales Pence]) / 100",
            "formatString": "£#,0;−£#,0",
            "lineageTag": "4d3e839b-cc1a-47f1-8401-f9fce7a9ce3d"
          },
          {
            "name": "Sales target",
            "expression": "SUM('Weekly Sales'[Target Pence]) / 100",
            "formatString": "£#,0;−£#,0",
            "lineageTag": "13317c3c-630d-4334-ab98-086543fe57b4"
          },
          {
            "name": "Sales vs prior year",
            "expression": "DIVIDE([Net sales] - [Prior-year sales], [Prior-year sales])",
            "formatString": "+0.0%;−0.0%;0.0%",
            "lineageTag": "ef497937-1397-4c3d-8f3a-1cb075bdd43f"
          },
          {
            "name": "Sales vs target",
            "expression": "DIVIDE([Net sales] - [Sales target], [Sales target])",
            "formatString": "+0.0%;−0.0%;0.0%",
            "lineageTag": "c72994c0-735c-4b58-b176-67572968ab62"
          },
          {
            "name": "Gross margin",
            "expression": "DIVIDE(SUM('Weekly Sales'[Profit Pence]), SUM('Weekly Sales'[Sales Pence]))",
            "formatString": "0.0%",
            "lineageTag": "004dcec2-e3a9-4aa7-a5e6-e5acb5bdae6e"
          },
          {
            "name": "Units sold",
            "expression": "SUM('Weekly Sales'[Units])",
            "formatString": "#,0",
            "lineageTag": "7c018cc4-8494-4d3c-968a-e7b53b602094"
          },
          {
            "name": "Promo sales share",
            "expression": "DIVIDE(SUM('Weekly Sales'[Promo Pence]), SUM('Weekly Sales'[Sales Pence]))",
            "formatString": "0.0%",
            "lineageTag": "5b3d7376-a150-4def-ba53-a602ea7d41d8"
          },
          {
            "name": "Stores",
            "expression": "DISTINCTCOUNT('Weekly Sales'[Store])",
            "formatString": "#,0",
            "lineageTag": "f057ff37-f510-4199-8826-cd6a07453bdb"
          },
          {
            "name": "Net sales per store",
            "expression": "DIVIDE([Net sales], [Stores])",
            "formatString": "£#,0;−£#,0",
            "lineageTag": "bf16ed43-1dc4-47bd-853d-6370dd8be83d"
          }
        ],
